{
	"name": "kxen-monorepo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"packages/*"
		],
		"catalog": {
			"@biomejs/biome": "^2.5.4",
			"@earendil-works/pi-agent-core": "^0.80.10",
			"@earendil-works/pi-ai": "^0.80.10",
			"@earendil-works/pi-coding-agent": "^0.80.10",
			"@earendil-works/pi-tui": "^0.80.10",
			"@types/bun": "^1.3.14",
			"@types/node": "^26.1.1",
			"typebox": "^1.1.38",
			"typescript": "^7.0.2"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"scripts": {
		"build": "bun run typecheck && bun run scripts/build.ts",
		"build:all": "bun run typecheck && bun run scripts/build.ts --all",
		"check": "bun run scripts/check.ts",
		"lint": "biome lint .",
		"typecheck": "tsc -p tsconfig.base.json --noEmit",
		"test": "bun test"
	}
}
