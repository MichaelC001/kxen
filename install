#!/usr/bin/env bash
set -euo pipefail
APP=kxen

MUTED='\033[0;2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

INSTALL_DIR="${KXEN_INSTALL_DIR:-$HOME/.kxen/source}"
BIN_DIR="${KXEN_BIN_DIR:-$HOME/.local/bin}"
REPO="https://github.com/StringKe/kxen"

usage() {
    cat <<EOF
kxen Installer（源码形态：clone + bun install + kxen 命令）

Usage: install [options]

Options:
    -h, --help        显示帮助
    --dir <path>      源码安装目录（默认 ~/.kxen/source）
    --bin-dir <path>  kxen 命令输出目录（默认 ~/.local/bin）

环境变量: KXEN_INSTALL_DIR / KXEN_BIN_DIR 与上述选项等价。
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dir) INSTALL_DIR="$2"; shift 2 ;;
        --bin-dir) BIN_DIR="$2"; shift 2 ;;
        *) echo -e "${RED}未知参数: $1${NC}"; usage; exit 1 ;;
    esac
done

info() { echo -e "${MUTED}$1${NC}"; }
ok() { echo -e "${GREEN}$1${NC}"; }

# 1. bun 运行时（mise 优先，其次官方安装器）
if ! command -v bun >/dev/null 2>&1; then
    info "bun 未安装，准备安装..."
    if command -v mise >/dev/null 2>&1; then
        mise use -g bun@1.3.14
    else
        curl -fsSL https://bun.sh/install | bash
        export PATH="$HOME/.bun/bin:$PATH"
    fi
fi
ok "bun $(bun --version)"

# 2. 源码（存在则 fast-forward 更新）
if [ -d "$INSTALL_DIR/.git" ]; then
    info "更新 $INSTALL_DIR ..."
    git -C "$INSTALL_DIR" pull --ff-only
else
    info "克隆 $REPO -> $INSTALL_DIR ..."
    mkdir -p "$(dirname "$INSTALL_DIR")"
    git clone --depth 1 "$REPO" "$INSTALL_DIR"
fi

# 3. 依赖
cd "$INSTALL_DIR"
bun install

# 4. kxen 命令 wrapper
mkdir -p "$BIN_DIR"
cat > "$BIN_DIR/kxen" <<EOF
#!/usr/bin/env bash
exec bun run --cwd "$INSTALL_DIR/packages/opencode" --conditions=browser src/index.ts "\$@"
EOF
chmod +x "$BIN_DIR/kxen"

ok "kxen 安装完成"
echo
echo "  确保 $BIN_DIR 在 PATH 中，然后："
echo "    kxen          启动 daemon + 浏览器 GUI"
echo "    kxen doctor   环境自检（bun / 订阅凭证 / 端口）"
echo "    kxen stop     停止"
echo "    kxen upgrade  自更新"
