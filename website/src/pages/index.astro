---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { homeDescription, homeTitle } from "../lib/home-content";
import { jsonLd } from "../lib/json-ld";

const softwareApplicationLd = jsonLd({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "kxen",
  operatingSystem: "macOS, Windows, Linux",
  applicationCategory: "DeveloperApplication",
  description: homeDescription,
});
// 首页的 markdown 交替页（/index.md）：Agent 指令与 PageActions 需要显式传入。
const markdownUrl = Astro.site ? new URL("/index.md", Astro.site).href : "/index.md";
// 稳定 asset 名以 scripts/release-manifest.sh 为单一出处，永久链接解析到最新版本。
const dl = (asset: string) => `https://github.com/StringKe/kxen/releases/latest/download/${asset}`;
---

<BaseLayout title={homeTitle} description={homeDescription} markdownUrl={markdownUrl} head={[softwareApplicationLd]}>
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-1 mx-auto max-w-5xl w-full px-6 py-16 sm:py-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
          开发预览
        </div>
        <div class="mt-6 flex items-center gap-5">
          <img src="/icon.png" width="76" height="76" alt="" class="h-16 w-16 rounded-2xl shadow-lg sm:h-20 sm:w-20" />
          <h1
            class="text-foreground leading-tight"
            style="font-size: clamp(3rem, 9vw, 5.75rem); font-weight: 700; letter-spacing: -0.055em;"
          >
            kxen
          </h1>
        </div>
        <p class="mt-6 max-w-2xl text-xl text-foreground leading-relaxed sm:text-2xl">
          一个原生、可控、面向复杂软件工程任务的 Coding Agent Harness。
        </p>
        <p class="mt-4 max-w-2xl text-base text-muted-foreground leading-relaxed sm:text-lg">
          覆盖 macOS、Windows 和 Linux 桌面，也可以用浏览器访问。把 Workspace、Session、模型、目标和 Agent 执行过程放进一个本地应用。
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            id="download-primary"
            href="https://github.com/StringKe/kxen/releases/latest"
            class="rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground no-underline transition-colors hover:bg-primary-hover"
          >
            下载 kxen
          </a>
          <a href="/getting-started" class="rounded-lg border border-border-strong bg-card px-4 py-2.5 text-sm font-semibold text-foreground no-underline transition-colors hover:bg-accent">
            开始使用
          </a>
          <a href="/overview" class="px-2 py-2.5 text-sm font-semibold text-muted-foreground no-underline transition-colors hover:text-foreground">
            了解 kxen
          </a>
        </div>
        <p class="mt-3 text-xs text-muted-foreground">
          桌面应用内置自动更新。kxen-web 无头 server 可以在服务器上运行，用浏览器访问全部功能。
        </p>
      </div>

      <section class="mt-16" aria-labelledby="download-heading">
        <h2 id="download-heading" class="text-lg font-semibold text-foreground">下载</h2>
        <p class="mt-1.5 text-sm text-muted-foreground">链接指向 GitHub Releases 的稳定 asset，始终解析到最新版本。</p>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-border bg-card p-5">
            <div class="font-semibold text-foreground">macOS</div>
            <div class="mt-2 flex flex-col gap-1.5 text-sm">
              <a href={dl("kxen-macos-aarch64.dmg")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">Apple Silicon (DMG)</a>
              <a href={dl("kxen-macos-x86_64.dmg")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">Intel (DMG)</a>
            </div>
            <div class="mt-2.5 text-xs leading-relaxed text-muted-foreground">Developer ID 签名并经 Apple 公证，需要 macOS 14 及以上版本。</div>
          </div>
          <div class="rounded-xl border border-border bg-card p-5">
            <div class="font-semibold text-foreground">Windows</div>
            <div class="mt-2 flex flex-col gap-1.5 text-sm">
              <a href={dl("kxen-windows-x86_64-setup.exe")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">x64 (NSIS setup)</a>
              <a href={dl("kxen-windows-aarch64-setup.exe")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">ARM64 (NSIS setup)</a>
            </div>
            <div class="mt-2.5 text-xs leading-relaxed text-muted-foreground">安装包暂未做 Authenticode 签名，SmartScreen 提示时选择 More info -&gt; Run anyway。</div>
          </div>
          <div class="rounded-xl border border-border bg-card p-5">
            <div class="font-semibold text-foreground">Linux</div>
            <div class="mt-2 flex flex-col gap-1.5 text-sm">
              <div>
                <a href={dl("kxen-linux-x86_64.AppImage")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">x86_64 AppImage</a>
                <span class="text-muted-foreground"> / </span>
                <a href={dl("kxen-linux-x86_64.deb")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">deb</a>
              </div>
              <div>
                <a href={dl("kxen-linux-aarch64.AppImage")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">ARM64 AppImage</a>
                <span class="text-muted-foreground"> / </span>
                <a href={dl("kxen-linux-aarch64.deb")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">deb</a>
              </div>
            </div>
            <div class="mt-2.5 text-xs leading-relaxed text-muted-foreground">deb 不进入应用内更新通道，经本页下载更新。</div>
          </div>
          <div class="rounded-xl border border-border bg-card p-5">
            <div class="font-semibold text-foreground">kxen-web 无头 server</div>
            <div class="mt-2 flex flex-col gap-1.5 text-sm">
              <div>
                <a href={dl("kxen-web-macos-aarch64.tar.gz")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">macOS Apple Silicon</a>
                <span class="text-muted-foreground"> / </span>
                <a href={dl("kxen-web-macos-x86_64.tar.gz")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">Intel</a>
              </div>
              <div>
                <a href={dl("kxen-web-linux-x86_64.tar.gz")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">Linux x86_64</a>
                <span class="text-muted-foreground"> / </span>
                <a href={dl("kxen-web-linux-aarch64.tar.gz")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">ARM64</a>
              </div>
              <div>
                <a href={dl("kxen-web-windows-x86_64.zip")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">Windows x64</a>
                <span class="text-muted-foreground"> / </span>
                <a href={dl("kxen-web-windows-aarch64.zip")} class="text-foreground underline decoration-border-strong underline-offset-4 hover:text-primary">ARM64</a>
              </div>
            </div>
            <div class="mt-2.5 text-xs leading-relaxed text-muted-foreground">
              启动后打印带 token 的访问 URL，浏览器打开即用。用法见 <a href="/getting-started/web-mode" class="text-foreground underline">Web 模式</a>。
            </div>
          </div>
        </div>
      </section>

      <div class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <a
          href="/workspace/workspace"
          class="block rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 no-underline"
        >
          <div class="font-semibold text-foreground">Workspace</div>
          <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">以本地项目为边界组织配置、知识、工具和执行状态。</div>
        </a>
        <a
          href="/workspace/composer"
          class="block rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 no-underline"
        >
          <div class="font-semibold text-foreground">Composer</div>
          <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">组合文本、文件、图片、命令、知识和语音输入。</div>
        </a>
        <a
          href="/agent/goal"
          class="block rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 no-underline"
        >
          <div class="font-semibold text-foreground">Goal</div>
          <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">用可验证的完成条件管理跨多轮的软件工程任务。</div>
        </a>
        <a
          href="/models/model-routing"
          class="block rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 no-underline"
        >
          <div class="font-semibold text-foreground">模型路由</div>
          <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">按角色配置 Provider、模型、账号和降级链。</div>
        </a>
        <a
          href="/knowledge/knowledge-library"
          class="block rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 no-underline"
        >
          <div class="font-semibold text-foreground">Knowledge Library</div>
          <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">统一管理项目和个人范围的规则、资料与长期知识。</div>
        </a>
        <a
          href="/agent/safety"
          class="block rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/40 no-underline"
        >
          <div class="font-semibold text-foreground">Safety</div>
          <div class="mt-1.5 text-sm leading-relaxed text-muted-foreground">在工具执行层拒绝、审批或记录高风险操作。</div>
        </a>
      </div>

      <div class="mt-16 border-t border-border pt-8 text-sm text-muted-foreground">
        当前版本为开发预览。全部安装包和校验信息见 <a href="https://github.com/StringKe/kxen/releases/latest" class="text-foreground underline">GitHub Releases</a>。
      </div>
    </main>
  </div>
</BaseLayout>

<script>
  // SSG 下的平台检测：把主按钮改写到当前平台的稳定 asset；失败时保持 Releases 页链接。
  const button = document.getElementById("download-primary");
  if (button instanceof HTMLAnchorElement) {
    const base = "https://github.com/StringKe/kxen/releases/latest/download/";
    const ua = navigator.userAgent;
    const apply = (arch?: string) => {
      if (/Windows/i.test(ua)) {
        if (arch === "arm") {
          button.href = base + "kxen-windows-aarch64-setup.exe";
          button.textContent = "下载 Windows ARM64 版";
        } else {
          button.href = base + "kxen-windows-x86_64-setup.exe";
          button.textContent = "下载 Windows 版";
        }
      } else if (/Mac OS X|Macintosh/i.test(ua)) {
        if (arch === "x86") {
          button.href = base + "kxen-macos-x86_64.dmg";
          button.textContent = "下载 macOS Intel 版";
        } else {
          button.href = base + "kxen-macos-aarch64.dmg";
          button.textContent = "下载 macOS 版";
        }
      } else if (/Linux/i.test(ua)) {
        if (arch === "arm") {
          button.href = base + "kxen-linux-aarch64.AppImage";
          button.textContent = "下载 Linux ARM64 版";
        } else {
          button.href = base + "kxen-linux-x86_64.AppImage";
          button.textContent = "下载 Linux 版";
        }
      }
    };
    const uaData = (
      navigator as Navigator & {
        userAgentData?: { getHighEntropyValues?: (hints: string[]) => Promise<{ architecture?: string }> };
      }
    ).userAgentData;
    if (uaData?.getHighEntropyValues) {
      uaData
        .getHighEntropyValues(["architecture"])
        .then((hints) => apply(hints.architecture))
        .catch(() => apply());
    } else {
      apply();
    }
  }
</script>
