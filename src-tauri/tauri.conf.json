{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Kxen",
  "version": "0.1.8",
  "identifier": "ai.kxen.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7823",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "languages": ["English", "SimpChinese"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQzQzQkYxRkJFMUI4MTgKUldRWXVPSDc4VHZFMm9YS3dHelJYdWZZYThVUmwvdlV3ZGhVV2p0cnpSQ0pVYTRyTjAxUmhUSkYK",
      "endpoints": ["https://github.com/StringKe/kxen/releases/latest/download/latest.json"]
    }
  }
}
