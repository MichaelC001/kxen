{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "kxen",
  "version": "0.1.0",
  "identifier": "ai.kxen.app",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:7823",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kxen",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": null,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "kxen 需要麦克风用于语音输入（Apple 本地语音识别，音频不上传）"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}